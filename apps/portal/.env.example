# Base URL of the NestJS API. The portal talks to it from the browser with the customer
# session cookie (the API's CORS_ORIGINS must include this app's origin).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site (store links)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Same as the web app: share the visitor id, consent and attribution across subdomains.
NEXT_PUBLIC_COOKIE_DOMAIN=
NEXT_PUBLIC_OWN_HOSTS=
