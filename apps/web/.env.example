# Public canonical origin (no trailing slash). Used for metadataBase, canonicals, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Server-side base URL of the NestJS API.
API_URL=http://localhost:4000
# Browser-side API URL (checkout runs in the browser so the customer session cookie is sent).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Customer portal origin (links after checkout, "My account").
NEXT_PUBLIC_PORTAL_URL=http://localhost:3102
# Shared secret the API signs /api/revalidate calls with (same value as apps/api REVALIDATE_SECRET).
REVALIDATE_SECRET=dev-only-revalidate-secret
# Set to 1 to preview the example (sample) products in the store. Development only.
STORE_SAMPLES=
# Public contact email shown in the footer (hidden when empty).
NEXT_PUBLIC_CONTACT_EMAIL=
# Cloudflare Turnstile site key for the collaborate and checkout forms (dev falls back to the test key).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Analytics fallbacks, used only when the API can't be reached (normally set in Admin → Settings).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# e.g. .shimanto.xyz so the site and the portal share the visitor id, consent and attribution.
NEXT_PUBLIC_COOKIE_DOMAIN=
# Comma-separated hosts treated as internal (not referrals), e.g. shimanto.xyz,my.shimanto.xyz
NEXT_PUBLIC_OWN_HOSTS=

# Publishing OS draft previews (local development). Leave empty to keep /publishing-os/preview off.
# The secret must match PUBLISHING_OS_PREVIEW_SECRET in Publishing OS's .env.local.
PUBLISHING_OS_URL=
PUBLISHING_OS_PREVIEW_SECRET=
