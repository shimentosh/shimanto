# Base URL of the NestJS API. The admin panel talks to it from the browser with the admin
# session cookie (the API's CORS_ORIGINS must include this app's origin).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site and customer portal (links from orders and products)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_PORTAL_URL=http://localhost:3102
