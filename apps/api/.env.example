# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# Comma-separated origins allowed to call the API (web, admin, portal)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102
# Set true behind a reverse proxy / load balancer so rate limits see real client IPs
TRUST_PROXY=false

# ── Data (docker compose defaults) ─────────────────────
DATABASE_URL=postgresql://shimanto:shimanto@localhost:5432/shimanto?schema=public
REDIS_URL=redis://localhost:6379
# bullmq (Redis queue with retries) | inline (run jobs in-process)
JOBS_DRIVER=bullmq

# ── Storage (RustFS locally; R2/S3 in production) ──────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shimanto-media
S3_ACCESS_KEY=shimanto
S3_SECRET_KEY=shimanto-dev-secret
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_URL=http://localhost:9000/shimanto-media
# Cloudflare R2 in production:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto  S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY / S3_SECRET_KEY = an R2 API token scoped to this bucket (Object Read & Write)
#   Only media/* is public (via a custom domain); product files live under private/ and are
#   downloaded through 5-minute signed URLs after an entitlement check.
# Largest product file an admin can upload, in MB (streamed through the API to storage)
FILE_UPLOAD_MAX_MB=250

# ── Auth (production: generate with `openssl rand -base64 48`) ─
JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# e.g. .shimanto.xyz in production so admin/portal subdomains share the session
COOKIE_DOMAIN=
# Customer portal session length (days). Password changes end older sessions at once.
CUSTOMER_SESSION_DAYS=30

# ── Email ──────────────────────────────────────────────
# Production: Resend (https://resend.com/api-keys). MAIL_FROM must use a domain verified in Resend.
# When RESEND_API_KEY is empty, email goes to SMTP_URL (Mailpit inbox: http://localhost:8025).
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Shimanto <no-reply@shimanto.xyz>
# Where customers' replies to transactional email go (optional; the store's support email wins)
MAIL_REPLY_TO=
# Where new-lead and new-ticket notifications go (leave empty to skip)
NOTIFY_EMAIL=

# ── Anti-spam ──────────────────────────────────────────
# Cloudflare's always-pass test secret; production requires a real key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
LEADS_RATE_LIMIT_PER_MINUTE=5

# ── Payments (Stripe) ─────────────────────────────────
# Leave empty to run with free products only. Test keys: https://dashboard.stripe.com/test/apikeys
# Local webhooks: `stripe listen --forward-to localhost:4000/v1/webhooks/stripe` prints the whsec_…
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Analytics & tracking (all optional) ─────────────────
# Public IDs can also be set in Admin → Settings → Analytics & Tracking (those win).
GA4_MEASUREMENT_ID=
# GA4 → Admin → Data streams → Measurement Protocol API secrets. Enables server-side purchases.
GA4_API_SECRET=
GTM_CONTAINER_ID=
META_PIXEL_ID=
# Meta Events Manager → Settings → Conversions API → Generate access token. Server-side only.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
# Events Manager "Test events" code (remove in production)
META_TEST_EVENT_CODE=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=

# ── GitHub repository delivery ─────────────────────────
# Preferred: a GitHub App (Settings → Developer settings → GitHub Apps) installed on the repos you
# sell, with Repository permission "Administration: Read & write" and the "Member" webhook event.
#   Callback URL:  <API_PUBLIC_URL>/v1/github/callback     Webhook URL: <API_PUBLIC_URL>/v1/webhooks/github
# The App's client id/secret identify customers' GitHub accounts (identity only, no token is kept).
GITHUB_APP_ID=
# PEM private key of the App (one line with literal "\n" escapes is fine)
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Fallback when no App is configured: a fine-grained PAT with Administration read & write on the repos
GITHUB_TOKEN=

# ── Web integration ────────────────────────────────────
SITE_URL=http://localhost:3100
# Customer portal (sign-in links, orders, downloads, support)
PORTAL_URL=http://localhost:3102
ADMIN_URL=http://localhost:3101
API_PUBLIC_URL=http://localhost:4000
REVALIDATE_SECRET=dev-only-revalidate-secret
WEB_REVALIDATE_URL=http://localhost:3100/api/revalidate

# ── Seed (first super admin; used by `pnpm db:seed` only) ─
ADMIN_EMAIL=
ADMIN_PASSWORD=
