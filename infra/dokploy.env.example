# Paste into Dokploy → shimanto (Compose) → Environment, then fill in the values.
# Only the REQUIRED block must be set; everything else has a working default or is optional.
# Values are read by docker-compose.prod.yml. See docs/DEPLOY.md.

# ── REQUIRED ───────────────────────────────────────────
# Dokploy → Postgres service → "Internal Connection URL" (add ?schema=public at the end)
DATABASE_URL=postgresql://shimanto:<password>@<postgres-internal-host>:5432/shimanto?schema=public
# Dokploy → Redis service → "Internal Connection URL"
REDIS_URL=redis://default:<password>@<redis-internal-host>:6379
# openssl rand -base64 48 (two different values)
JWT_ACCESS_SECRET=
REVALIDATE_SECRET=
# Cloudflare → Turnstile → add site (shimanto.xyz). Production refuses the test keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# First super admin, created on the first start (password ≥ 12 chars). Can be removed afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Storage: Cloudflare R2, needed for uploads (see docs/COMMERCE.md) ─
# https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 API token (Object Read & Write) scoped to the bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_BUCKET=shimanto-media
S3_FORCE_PATH_STYLE=true
# Public custom domain of the R2 bucket (serves media/*)
MEDIA_PUBLIC_URL=https://media.shimanto.xyz
FILE_UPLOAD_MAX_MB=250

# ── Email (Resend). Without RESEND_API_KEY emails are only logged. ─
RESEND_API_KEY=
MAIL_FROM=Shimanto <no-reply@shimanto.xyz>
MAIL_REPLY_TO=
NOTIFY_EMAIL=
# Public contact email in the site footer (hidden when empty)
CONTACT_EMAIL=

# ── Payments (Stripe; empty = free products only) ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Analytics & tracking (optional) ────────────────────
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GTM_CONTAINER_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=

# ── GitHub repository delivery (optional) ──────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# ── Domains (defaults shown; change only if you use other hosts) ─
SITE_URL=https://shimanto.xyz
API_PUBLIC_URL=https://api.shimanto.xyz
ADMIN_URL=https://admin.shimanto.xyz
PORTAL_URL=https://my.shimanto.xyz
COOKIE_DOMAIN=.shimanto.xyz
OWN_HOSTS=shimanto.xyz,www.shimanto.xyz,my.shimanto.xyz
