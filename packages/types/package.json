{
  "name": "@shimanto/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas, enums and DTO types for api, web, admin and portal.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@shimanto/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
