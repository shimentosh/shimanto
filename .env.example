# Docker Compose host-port overrides. Only needed when native services already use the defaults
# (e.g. a Windows PostgreSQL/Redis install). Remember to match apps/api/.env URLs.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# STORAGE_HOST_PORT=9000            # also set S3_ENDPOINT and MEDIA_PUBLIC_URL in apps/api/.env
# STORAGE_CONSOLE_HOST_PORT=9001
